ipaddr=192.168.1.1
serverip=192.168.1.10
loadaddr=0x81800000
bootfile=w1700k-system.itb
fitfile=w1700k-system.itb
rootfsfile=rootfs.squashfs
bootargs=console=ttyS0,115200 earlycon panic=5 ro rdinit=/init ubi.mtd=system ubi.block=0,rootfs
verify=yes
autostart=no
bootpart=system
bootvol=fit
bootconf=conf-sdr
bootlimit=1
bootcmd=run gps_off; run board_id; run efr32_off; run loader_next; run update_apply; run key_pass; run efr32_pass; ubi part.ro ${bootpart} && ubi read ${loadaddr} ${bootvol} && iminfo ${loadaddr} && run system_start
update_spare=0x94000000
update_check=hash sha256 ${loadaddr} ${filesize} update_got && test "${update_got}" = "${update_want}"
update_fetch=ubi part.ro durable && ubifsmount ubi0:durable && ubifsload ${loadaddr} update/${update_file} && run update_check
update_store=ubifsumount; ubi part.rw ${bootpart} && ubi write ${loadaddr} rootfs ${filesize} && ubi read ${update_spare} rootfs ${filesize} && hash sha256 ${update_spare} ${filesize} update_got && test "${update_got}" = "${update_want}"
update_done=setenv update_new; setenv update_old; setenv loader_new; setenv update_file; setenv update_want; setenv update_got; saveenv
update_back=echo "update: putting the previous root back"; setenv update_file rootfs.old; setenv update_want ${update_old}; if run update_fetch && run update_store; then setenv update_failed ${update_new}; setenv update_tried; run update_done; echo "update: the previous root is back"; else echo "update: the previous root could not be put back"; fi
update_try=echo "update: writing the staged root"; setenv update_file rootfs.new; setenv update_want ${update_new}; if run update_fetch; then if run update_store; then setenv update_tried ${update_new}; setenv update_failed; run update_done; echo "update: written; it stays once confirmed"; else echo "update: the write failed"; run update_back; fi; else echo "update: the staged root is unreadable or not the one announced; nothing written"; fi
update_decide=if test "${update_tried}" = "${update_new}"; then echo "update: the new root was not confirmed"; run update_back; else if test "${update_failed}" = "${update_new}"; then echo "update: this one failed before; left alone"; else run update_try; fi; fi
update_apply=if ubi part.ro durable && ubifsmount ubi0:durable; then setenv update_new; setenv update_old; setenv loader_new; if ubifsload ${update_spare} update/request; then env import -t ${update_spare} ${filesize} update_new update_old loader_new; fi; if test -n "${update_new}" && test -n "${update_old}"; then run update_decide; else if test -z "${loader_new}"; then run update_settle; fi; fi; ubifsumount; fi
update_settle=if env exists update_tried || env exists update_failed || env exists loader_tried || env exists loader_failed || env exists loader_booted; then echo "update: settled"; env erase; setenv update_tried; setenv update_failed; setenv loader_tried; setenv loader_failed; setenv loader_booted; fi
key_pass=setenv key_line; setenv key_on; if ubi part.ro durable && ubifsmount ubi0:durable; then if ubifsload ${update_spare} key/slot; then env import -t ${update_spare} ${filesize} key_line key_on; fi; ubifsumount; fi; if test -n "${key_line}"; then if test "${key_on}" = "1"; then setenv bootargs "${bootargs} w1700k.keyslot=on w1700k.key=${key_line}"; else setenv bootargs "${bootargs} w1700k.keyslot=off"; fi; else setenv bootargs "${bootargs} w1700k.keyslot=empty"; fi; setenv key_line; setenv key_on
system_start=if bootm start ${loadaddr}#${bootconf} && bootm loados && bootm ramdisk && bootm fdt; then run board_pass; bootm prep && bootm go; fi
gps_off=setexpr gps_v *0x1fbf0278 "|" 0x800 && mw 0x1fbf0278 ${gps_v} && setexpr gps_v *0x1fbf0260 "|" 0x400000 && mw 0x1fbf0260 ${gps_v} && setexpr gps_v *0x1fbf0270 "&" 0xfffff7ff && mw 0x1fbf0270 ${gps_v}; setenv gps_v
board_id=setenv board unknown; setenv serial_number; if mtd read calibration ${update_spare} 0 0x800; then env import -t ${update_spare} 0x800 serial_number; fi; if test "x${serial_number}" ">" "xW1700K" && test "x${serial_number}" "<" "xW1700L"; then setenv board w1700k; fi; if test "x${serial_number}" ">" "xXR1710G" && test "x${serial_number}" "<" "xXR1710H"; then setenv board xr1710g; run board_xr1710g; fi; setenv serial_number
board_xr1710g=setexpr gps_v *0x1fbf0270 "|" 0x800 && mw 0x1fbf0270 ${gps_v}; setenv gps_v
efr32_off=if test "${board}" = "w1700k"; then setexpr efr32_v *0x1fbf0214 "|" 0x1000000 && mw 0x1fbf0214 ${efr32_v} && setexpr efr32_v *0x1fbf0220 "|" 0x10000 && mw 0x1fbf0220 ${efr32_v} && setexpr efr32_v *0x1fbf0204 "&" 0xfeffffff && mw 0x1fbf0204 ${efr32_v}; fi; setenv efr32_v
efr32_pass=setenv efr32_keep; if test "${board}" = "w1700k"; then if ubi part.ro durable && ubifsmount ubi0:durable; then if ubifsload ${update_spare} efr32/switch; then env import -t ${update_spare} ${filesize} efr32_keep; fi; ubifsumount; fi; if test "${efr32_keep}" = "on"; then setexpr efr32_v *0x1fbf0214 "&" 0xfeffffff && mw 0x1fbf0214 ${efr32_v} && setexpr efr32_v *0x1fbf0220 "&" 0xfffcffff && mw 0x1fbf0220 ${efr32_v}; setenv bootargs "${bootargs} w1700k.efr32=on"; else setenv bootargs "${bootargs} w1700k.efr32=off"; fi; fi; setenv efr32_keep; setenv efr32_v
board_pass=fdt set /chosen w1700k,board "${board}"; setenv bootargs "${bootargs} w1700k.board=${board}"
loader_slot=a
bootdelay=5
loader_b_at=0x8e000000
loader_b_kind=W1700K SDR second ARM loader
loader_next=if test "${loader_slot}" = "b"; then echo "loader: this is the second loader"; run loader_seen; else run loader_first; fi
loader_seen=if env exists loader_tried; then if test "${loader_booted}" != "${loader_tried}"; then setenv loader_booted ${loader_tried}; saveenv; fi; fi
loader_first=setenv loader_new; if ubi part.ro durable && ubifsmount ubi0:durable; then if ubifsload ${update_spare} update/request; then env import -t ${update_spare} ${filesize} loader_new; fi; if test -n "${loader_new}"; then run loader_decide; fi; ubifsumount; fi; run loader_start
loader_decide=if test "${loader_tried}" = "${loader_new}"; then echo "loader: the new loader was not confirmed; removing it"; run loader_drop; setenv loader_failed ${loader_new}; setenv loader_tried; setenv loader_booted; run loader_save; else if test "${loader_failed}" = "${loader_new}"; then echo "loader: this one failed before; left alone"; else run loader_try; fi; fi
loader_try=echo "loader: writing the staged loader"; setenv update_file loader.new; setenv update_want ${loader_new}; if run update_fetch && run loader_is_b; then if run loader_store; then setenv loader_tried ${update_want}; setenv loader_failed; setenv loader_booted; run loader_save; echo "loader: written; it stays once confirmed"; else echo "loader: the write failed; removing it"; run loader_drop; fi; else echo "loader: the staged loader is unreadable, not the one announced or not a second loader; nothing written"; fi
loader_is_b=setenv loader_kind; fdt addr ${loadaddr} && fdt get value loader_kind / description && test "${loader_kind}" = "${loader_b_kind}"
loader_store=ubifsumount; mtd erase loader-b && mtd write loader-b ${loadaddr} 0 ${filesize} && mtd read loader-b ${update_spare} 0 ${filesize} && hash sha256 ${update_spare} ${filesize} update_got && test "${update_got}" = "${update_want}"
loader_drop=ubifsumount; mtd erase loader-b
loader_save=setenv update_file; setenv update_want; setenv update_got; setenv loader_new; setenv loader_kind; saveenv
loader_start=setenv loader_kind; if mtd read loader-b ${loader_b_at} 0 0x1000 && fdt addr ${loader_b_at} && mtd read loader-b ${loader_b_at}; then if fdt get value loader_kind / description && test "${loader_kind}" = "${loader_b_kind}" && iminfo ${loader_b_at}; then echo "loader: starting the second loader"; bootm ${loader_b_at}; echo "loader: the second loader did not start"; else echo "loader: what is in loader-b is not a whole second loader; not started"; fi; fi; setenv loader_kind
altbootcmd=echo *** boot limit exceeded, stopping at prompt ***
boot_tftp=tftpboot ${loadaddr} ${bootfile} && iminfo ${loadaddr} && bootm ${loadaddr}#${bootconf}
update_fit=tftpboot ${loadaddr} ${fitfile} && ubi part.rw ${bootpart} && ubi write ${loadaddr} fit ${filesize}
update_rootfs=tftpboot ${loadaddr} ${rootfsfile} && ubi part.rw ${bootpart} && ubi write ${loadaddr} rootfs ${filesize}
bootm_low=0x80000000
bootm_size=0x80000000
bootm_mapsize=0x80000000
fdt_high=0x84000000
