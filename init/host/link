#!/bin/sh
# SPDX-License-Identifier: MIT
# Give a host interface the address (and MTU) used on one of the unit's links.
#
#   sudo init/host/link up IFACE [CIDR [MTU]]     # default 192.168.1.10/24, MTU unchanged
#   sudo init/host/link down IFACE [CIDR]
#   sudo init/host/link keep IFACE [CIDR [MTU]]   # the same as `up`, and for every time IFACE appears
#
# The management link (unit lan3) uses 192.168.1.10/24; the 10 GbE IQ link (unit
# eth1) uses 10.77.0.10/24 with MTU 9216. Only the named address is added or
# removed; routes and other addresses are left alone.
#
# Given an MTU (the IQ link), the receive ring is also raised to the NIC's
# maximum: the stream is about 150,000 datagrams/s, so a default 512-entry ring
# holds 3.4 ms, and a host stall longer than that (a parallel build, say) drops
# slices before any socket sees them.
#
# Given an MTU, an interface with one receive queue (a USB adapter) also gets its
# packets spread: all of them arrive on the one CPU its interrupt lands on, by
# default the CPU most other interrupts share, and at 127,000 datagrams a second
# (320 Msps on 5 Gbit/s) that CPU fell behind often enough for the adapter to
# miss 1 datagram in 2400. The interrupt (the adapter's, or its USB controller's)
# is moved to the last CPU, and the IP and UDP work of each datagram is steered to
# the others (receive packet steering). Measured with tools/host_rx_trial: 53
# datagrams missed a second as it was, 13 with steering alone, 32 with the
# interrupt moved alone, 1 with both. An interface with several queues is left as
# it is. `down` puts both back.
#
# The kernel thread that takes over that CPU's packet work when there is much of
# it (ksoftirqd/N) is raised to nice -10 with the interrupt, and `keep` lets the
# user who ran sudo raise w1700k-stream as far (/etc/security/limits.d/
# 60-w1700k-stream.conf, which holds from the next login; delete it to undo). On
# a host with every CPU busy both otherwise share their CPUs evenly with whatever
# else runs: a 320 Msps stream lost 2.1 % of its slices in a minute like that,
# 0.008 to 0.08 % with the service raised, and between none and 0.04 % in six
# such minutes with both (host/stream/README.md has the runs).
#
# Given an MTU, the user who ran sudo is also given /dev/cpu_dma_latency, the file
# through which the kernel is asked to keep the CPUs out of their deep idle states,
# and w1700k-stream asks while datagrams arrive (host/stream/src/awake.h). A
# stream at 40 or 80 Msps arrives in clumps with idle stretches between them, long
# enough for a host to put every CPU to sleep and then enter its deepest,
# whole-system state, which no CPU awake allows. On an arm64 host whose CPU sleep
# state takes 1.3 ms to leave, an RTL8159 missed 1 datagram in 250 of the 16-bit
# format at 40 Msps (0.3 to 0.9 % of slices over eleven runs) and 1 in 500 at 80;
# with any one CPU kept busy instead, 10 slices of 389,000 and 8 of 783,000.
# Faster streams keep the host awake by themselves. Whoever holds that file can
# cost the machine its idle power and nothing else. Run as root itself, there is
# nobody to give it to, and a w1700k-stream that is not root's says it cannot ask.
#
# `up` lasts until the interface goes away: a reboot, or a USB adapter pulled and
# plugged in again, which comes back with an MTU of 1500 and drops the stream's
# 8 KiB packets without a word. `keep` also has NetworkManager hold the address,
# the MTU and the ring, and writes the spreading into a hook NetworkManager runs
# when IFACE comes up (/etc/NetworkManager/dispatcher.d/60-w1700k-IFACE), so that
# all of it is applied whenever the interface appears, and the owner of
# /dev/cpu_dma_latency into a udev rule (/etc/udev/rules.d/60-w1700k-stream.rules;
# delete it to undo), since /dev is made anew at every boot. Without
# NetworkManager it says so, and `up` has to be repeated.
#
# Where NetworkManager keeps them: in a connection of its own for the interface,
# `w1700k-IFACE`, with the address set by hand (ipv4.method manual) and a higher
# autoconnect priority than a connection NetworkManager made for the interface
# itself, and it has NetworkManager bring that connection up. A connection that
# asks for an address by DHCP cannot keep one: no unit answers DHCP, and when the
# request times out NetworkManager takes every address off the interface. Nor
# can the connection NetworkManager assumes when an address is set by hand
# ("connected (externally)"): it is gone when the interface is. Only a connection
# of your own that already manages IFACE with its address set by hand is used as
# it is, with this address added to it. While `w1700k-IFACE` exists the interface
# asks for no address by DHCP; `down` removes it, and the hook.
#
# `up` beside a NetworkManager that is still waiting for DHCP on IFACE stops that
# request, and says so: the address would otherwise go when it times out.
set -eu
[ "$(id -u)" = 0 ] || { echo "$0: run as root (sudo)" >&2; exit 1; }
[ $# -ge 2 ] || { echo "usage: $0 up|down|keep IFACE [CIDR [MTU]]" >&2; exit 2; }
action=$1 iface=$2 cidr=${3:-192.168.1.10/24} mtu=${4:-}
sysroot=${W1700K_LINK_SYSROOT:-}	# where /sys, /proc and /etc are, for the tests
ours=w1700k-$iface			# the NetworkManager connection `keep` makes
hook=$sysroot/etc/NetworkManager/dispatcher.d/60-w1700k-$iface

# spread IFACE on|off, as text: `keep` writes the same lines into NetworkManager's hook.
spread_source=$(cat <<'SPREAD'
spread() {
	net=${W1700K_LINK_SYSROOT:-}/sys/class/net/$1
	[ -e "$net/queues/rx-0/rps_cpus" ] && [ ! -e "$net/queues/rx-1" ] || return 0
	cpus=$(nproc --all)
	[ "$cpus" -ge 2 ] && [ "$cpus" -le 32 ] || return 0
	last=$((cpus - 1))
	# The interrupt behind the interface: its own, or that of the controller it hangs from.
	dev=$(readlink -f "$net/device") irq=
	while [ "$dev" != "${W1700K_LINK_SYSROOT:-}/sys/devices" ] && [ "$dev" != / ] && [ "$dev" != . ]; do
		if [ -d "$dev/msi_irqs" ]; then irq=$(ls "$dev/msi_irqs" | head -1); break; fi
		if [ -r "$dev/irq" ] && [ "$(cat "$dev/irq")" != 0 ]; then irq=$(cat "$dev/irq"); break; fi
		# A USB controller that is no PCI device shows neither: its interrupt is listed
		# under the name of one of its buses (xhci-hcd:usb1), not always the adapter's.
		case ${dev##*/} in usb[0-9]*)
			for bus in "$dev" "${dev%/*}"/usb[0-9]*; do
				irq=$(awk -v n=":${bus##*/}" '$0 ~ n"(,|$)" { sub(":", "", $1); print $1; exit }' "${W1700K_LINK_SYSROOT:-}/proc/interrupts" 2>/dev/null)
				[ -z "$irq" ] || break 2
			done ;;
		esac
		dev=$(dirname "$dev")
	done
	# The CPU the interrupt is on now (where it was sent, or where it stayed) and that CPU's
	# kernel thread for packet work.
	softirqd() {
		[ -n "$irq" ] && [ -z "${W1700K_LINK_SYSROOT:-}" ] || return 0	# a real thread: not in the tests
		cpu=$(sed 's/[-,].*//' "/proc/irq/$irq/effective_affinity_list" 2>/dev/null) || return 0
		pid=$(pgrep -x "ksoftirqd/$cpu" 2>/dev/null | head -1) || return 0
		[ -z "$pid" ] || renice -n "$1" -p "$pid" >/dev/null 2>&1 || true
	}
	if [ "$2" = on ]; then
		[ -z "$irq" ] || echo "$last" > "${W1700K_LINK_SYSROOT:-}/proc/irq/$irq/smp_affinity_list" 2>/dev/null || true
		printf '%x\n' $(( ((1 << cpus) - 1) & ~(1 << last) )) > "$net/queues/rx-0/rps_cpus"
		softirqd -10
	else
		softirqd 0
		[ -z "$irq" ] || echo "0-$last" > "${W1700K_LINK_SYSROOT:-}/proc/irq/$irq/smp_affinity_list" 2>/dev/null || true
		echo 0 > "$net/queues/rx-0/rps_cpus"
	fi
}
SPREAD
)
eval "$spread_source"

latency=$sysroot/dev/cpu_dma_latency
awake()	# the user who ran sudo may ask the kernel to keep the CPUs out of deep idle
{
	[ -c "$latency" ] && [ -n "${SUDO_UID:-}" ] && [ "$SUDO_UID" != 0 ] || return 0
	chown "$SUDO_UID" "$latency" || echo "$0: could not give $latency to user $SUDO_UID" >&2
}

nm_runs() { command -v nmcli >/dev/null && nmcli -t general status >/dev/null 2>&1; }
nm_get() { nmcli -g "$1" connection show "$2" 2>/dev/null; }		# one setting of a connection
nm_has() { nmcli -g connection.id connection show "$1" >/dev/null 2>&1; }
nm_state() { nmcli -g GENERAL.STATE device show "$iface" 2>/dev/null; }
nm_active() { nmcli -g GENERAL.CONNECTION device show "$iface" 2>/dev/null; }
holds() { nm_get ipv4.addresses "$1" | tr ',' '\n' | grep -q "^ *${cidr%/*}/"; }	# connection $1 has $cidr

add_address()
{
	ip -4 -o address show dev "$iface" | grep -q " ${cidr%/*}/" || ip address add "$cidr" dev "$iface"
}

# The connection that keeps the address: ours if `keep` has made it before; else the one that
# manages $iface now, if NetworkManager will bring it up again by itself and its address is set by
# hand; else nothing, and ours is made. Not one that asks for DHCP (it loses every address when the
# request times out), and not one NetworkManager assumed from an address set by hand (it goes with
# the interface; on a netplan host its file is under /run like every other, so its state tells).
keeper()
{
	if nm_has "$ours"; then echo "$ours"; return 0; fi
	con=$(nm_active)
	[ -n "$con" ] || return 0
	case $(nm_state) in *externally*) return 0 ;; esac
	[ "$(nm_get connection.autoconnect "$con")" = yes ] || return 0
	case $(nm_get ipv4.method "$con") in
	manual|disabled|link-local) echo "$con" ;;
	esac
}

# An earlier `keep` added the address to the connection it found, a DHCP one included. Such a
# connection gets its address back out, so that it is again what NetworkManager made.
tidy()
{
	nmcli -g NAME connection show 2>/dev/null | sed 's/\\:/:/g' | while IFS= read -r other; do
		[ "$other" != "$ours" ] && [ "$(nm_get connection.interface-name "$other")" = "$iface" ] &&
			[ "$(nm_get ipv4.method "$other")" = auto ] && holds "$other" || continue
		nmcli connection modify "$other" -ipv4.addresses "$cidr" 2>/dev/null &&
			echo "$0: took $cidr back out of \"$other\", which asks for its address by DHCP"
	done
}

keep()	# NetworkManager keeps $cidr, $mtu and the largest receive ring on $iface
{
	nm_runs || {
		add_address
		echo "$0: NetworkManager does not run here: nothing kept; repeat \`$0 up\` when $iface comes back" >&2
		return 1
	}
	[ -e "$sysroot/sys/class/net/$iface" ] || { echo "$0: no interface $iface" >&2; return 1; }
	con=$(keeper)
	if [ -z "$con" ]; then
		con=$ours
		# autoconnect off until it is whole: NetworkManager brings it up once, below.
		nmcli -t connection add type ethernet ifname "$iface" con-name "$con" autoconnect no \
			ipv4.method manual ipv4.addresses "$cidr" ipv4.never-default yes ipv6.method disabled >/dev/null
	else
		holds "$con" || nmcli connection modify "$con" +ipv4.addresses "$cidr"
		case $(nm_get ipv4.method "$con") in
		disabled|link-local) nmcli connection modify "$con" ipv4.method manual ;;
		esac
	fi
	if [ -n "$mtu" ]; then
		nmcli connection modify "$con" 802-3-ethernet.mtu "$mtu"
		rx=$(ethtool -g "$iface" 2>/dev/null | awk '/^RX:/ { print $2; exit }')
		[ -z "$rx" ] || nmcli connection modify "$con" ethtool.ring-rx "$rx" 2>/dev/null ||
			echo "$0: this NetworkManager does not keep the receive ring" >&2
	fi
	if [ "$con" = "$ours" ]; then
		# Above NetworkManager's own "Wired connection N" (-999) and a connection left at 0.
		nmcli connection modify "$con" connection.autoconnect yes connection.autoconnect-priority 10
		tidy
		# NetworkManager brings it up: the address is then its own, and it stops whatever
		# it was doing on the interface (a DHCP request, or a connection it had assumed).
		# Not where it is up already with the address on: that would only interrupt a stream.
		if [ "$(nm_active)" = "$con" ] && ip -4 -o address show dev "$iface" | grep -q " ${cidr%/*}/"; then
			:
		elif nmcli connection up "$con" ifname "$iface" >/dev/null 2>&1; then
			add_address	# there already, unless this NetworkManager leaves it to us
		else
			add_address
			echo "$0: NetworkManager did not bring \"$con\" up now; it will when $iface next appears" >&2
		fi
	else
		add_address
	fi
	echo "$0: kept in the NetworkManager connection \"$con\""
	[ -n "$mtu" ] && [ -d "$(dirname "$hook")" ] || return 0
	{
		echo '#!/bin/sh'
		echo "# Written by init/host/link keep $iface: the W1700K stream link's packets are spread"
		echo "# over the CPUs whenever the interface comes up. \`init/host/link down $iface\` removes it."
		echo "[ \"\$1\" = \"$iface\" ] && [ \"\$2\" = up ] || exit 0"
		echo "$spread_source"
		echo "spread \"$iface\" on"
	} > "$hook"
	chmod 755 "$hook"
	echo "$0: and in $hook"
	rule=$sysroot/etc/udev/rules.d/60-w1700k-stream.rules
	[ -c "$latency" ] && [ -n "${SUDO_UID:-}" ] && [ "$SUDO_UID" != 0 ] && [ -d "$(dirname "$rule")" ] || return 0
	{
		echo "# Written by init/host/link keep $iface: w1700k-stream, run by this user, may ask the"
		echo '# kernel to keep the CPUs out of deep idle while a stream arrives. Delete this file to undo.'
		echo "KERNEL==\"cpu_dma_latency\", OWNER=\"$SUDO_UID\""
	} > "$rule"
	echo "$0: and /dev/cpu_dma_latency is user $SUDO_UID's, in $rule"
	limit=$sysroot/etc/security/limits.d/60-w1700k-stream.conf
	[ -n "${SUDO_USER:-}" ] && [ -d "$(dirname "$limit")" ] || return 0
	{
		echo "# Written by init/host/link keep $iface: w1700k-stream, run by this user, may raise"
		echo '# itself to nice -10, so that a busy host does not starve it. Delete this file to undo.'
		echo "$SUDO_USER - nice -10"
	} > "$limit"
	echo "$0: and $SUDO_USER may run at nice -10 from the next login, in $limit"
}

# `up` beside a NetworkManager that is asking $iface for an address by DHCP and has none yet: when
# the request times out it takes every address off the interface, the one added here included.
stop_dhcp()
{
	nm_runs || return 0
	case $(nm_state) in *connecting*) ;; *) return 0 ;; esac
	con=$(nm_active)
	[ -n "$con" ] && [ "$(nm_get ipv4.method "$con")" = auto ] || return 0
	nmcli device disconnect "$iface" >/dev/null 2>&1 || return 0
	ip link set dev "$iface" up
	echo "$0: NetworkManager was waiting for an address by DHCP on $iface (\"$con\") and would have" >&2
	echo "$0: taken this one away when that failed: stopped it, until $iface next appears." >&2
	echo "$0: \`$0 keep $iface $cidr${mtu:+ $mtu}\` makes the address stay." >&2
}

case "$action" in
up|keep)
	[ -z "$mtu" ] || ip link set dev "$iface" mtu "$mtu"
	if [ -n "$mtu" ] && command -v ethtool >/dev/null; then
		# Only where it is not there yet: an r8152 adapter whose ring was set while a
		# stream arrived stopped receiving until it was taken down and up.
		rx=$(ethtool -g "$iface" 2>/dev/null | awk '/^RX:/ { print $2; exit }')
		now=$(ethtool -g "$iface" 2>/dev/null | awk '/^RX:/ { n = $2 } END { print n }')
		[ -z "$rx" ] || [ "$rx" = "$now" ] || ethtool -G "$iface" rx "$rx" 2>/dev/null ||
			echo "$0: could not raise the $iface receive ring" >&2
	fi
	[ -z "$mtu" ] || { spread "$iface" on; awake; }
	ip link set dev "$iface" up
	if [ "$action" = keep ]; then
		keep
	else
		stop_dhcp
		add_address
	fi
	;;
down)
	if nm_runs; then
		# What `keep` set: its own connection, or the address it added to one of yours.
		if nm_has "$ours"; then
			nmcli connection delete "$ours" >/dev/null &&
				echo "$0: removed the NetworkManager connection \"$ours\""
		fi
		con=$(nm_active)
		if [ -n "$con" ] && holds "$con"; then
			nmcli connection modify "$con" -ipv4.addresses "$cidr" 2>/dev/null ||
				echo "$0: the NetworkManager connection \"$con\" still has $cidr: it is its only address" >&2
		fi
	fi
	! ip -4 -o address show dev "$iface" | grep -q " ${cidr%/*}/" ||
		ip address del "$cidr" dev "$iface"
	spread "$iface" off
	[ ! -e "$hook" ] || { rm -f "$hook"; echo "$0: removed $hook"; }
	;;
*)
	echo "usage: $0 up|down|keep IFACE [CIDR [MTU]]" >&2
	exit 2
	;;
esac
ip -brief address show dev "$iface"
