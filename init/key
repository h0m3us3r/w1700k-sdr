#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Give a unit your login key with a paperclip: no serial console, no key on the unit before.

    init/key [FILE]          # FILE: a public key (default ~/.ssh/id_ed25519.pub, id_ecdsa.pub, id_rsa.pub)

Run it, then hold the unit's reset button with a paperclip. After ten seconds the LED flashes and
pulses blue: let go then. (Until then it rises white if the unit has no such key yet; with one, it
shows green or red and pulses from five seconds.) The unit waits three minutes for a key
(blue, breathing); this sends it.

The unit then holds the key and has not kept it (cyan, two beats and a rest), and this says
whether the key it holds is yours. When it is, hold the button three seconds, until the LED
flashes and pulses green, and let go: the key is kept, the LED turns to green, and this logs in
with it. When it is not, tap the button: that discards the key. So does a minute without a press.

The unit keeps one such key. Sending another replaces it. Holding the button five seconds (let go
while the LED pulses red) switches the key off without forgetting it, and five seconds again
(green) switches it back on. Fifteen seconds (let go while it blinks red, after the blue) erases
it. A press while the unit waits for a key ends the wait. See init/README.md.
"""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initkit import config, paperclip                  # noqa: E402


def main():
    settings = config.load()
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('key', nargs='?', metavar='FILE', help='the public key to send')
    parser.add_argument('--device-ip', default=settings['device_ip'], help='the unit (default: %(default)s)')
    parser.add_argument('--port', type=int, default=paperclip.PORT, help=argparse.SUPPRESS)
    parser.add_argument('--wait', type=float, default=paperclip.WAIT_SECONDS, metavar='SECONDS',
                        help='how long to wait for the unit to open its slot (default: %(default)s)')
    parser.add_argument('--known-hosts', metavar='FILE',
                        help="add the unit's host key to this known_hosts file")
    args = parser.parse_args()
    try:
        return paperclip.run(args.device_ip, args.key or settings.get('authorized_key'), port=args.port,
                             wait=args.wait, known_hosts=args.known_hosts)
    except paperclip.KeyProblem as error:
        sys.exit(f'key: {error}')
    except KeyboardInterrupt:
        sys.exit('key: stopped; nothing was sent')


if __name__ == '__main__':
    sys.exit(main())
